{
    "name": "monitor-api",
    "version": "1.9.0",
    "description": "Lightweight, signal-based web app monitoring library. Captures FPS, memory, network, React renders, events, Web Vitals, and optional errors.",
    "author": "ElJijuna <pilmee@gmail.com>",
    "license": "MIT",
    "homepage": "https://github.com/ElJijuna/monitor-api#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ElJijuna/monitor-api.git"
    },
    "bugs": {
        "url": "https://github.com/ElJijuna/monitor-api/issues"
    },
    "keywords": [
        "monitor",
        "performance",
        "fps",
        "network",
        "react",
        "signal",
        "ssignal",
        "observability",
        "web",
        "devtools"
    ],
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./react": {
            "import": {
                "types": "./dist/react/index.d.ts",
                "default": "./dist/react/index.js"
            },
            "require": {
                "types": "./dist/react/index.d.cts",
                "default": "./dist/react/index.cjs"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "PRIVACY.md",
        "COMPATIBILITY.md",
        "LICENSE"
    ],
    "scripts": {
        "bench": "npm run build && node bench/monitor.bench.mjs",
        "build": "node -e \"require(\\\"node:fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\" && tsup",
        "demo": "npm run build && node demo/server.mjs",
        "check": "npm run lint && npm run format:check && npm run typecheck",
        "docs:build": "typedoc",
        "dev": "tsup --watch",
        "format": "biome check --write .",
        "format:check": "biome check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "release": "semantic-release",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:coverage": "npm test -- --coverage",
        "test:browser": "npm ci --prefix test/browser/react-19 --no-audit --no-fund && npm run build && playwright test",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "prepublishOnly": "npm run check && npm run build",
        "test:package": "npm run build && publint --strict && node test/package/smoke.cjs && node test/package/smoke.mjs"
    },
    "dependencies": {
        "ssignal": "^1.9.1",
        "web-vitals": "^6.2.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@playwright/test": "^1.63.0",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/git": "^10.0.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.4",
        "@types/react": "^19.2.17",
        "@types/react-test-renderer": "^19.1.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.11.0",
        "jest": "^30.4.2",
        "publint": "^0.3.24",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-test-renderer": "^18.3.1",
        "semantic-release": "^25.0.9",
        "super-configs": "^1.26.0",
        "tsup": "^8.5.1",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "react": ">=18.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "overrides": {
        "esbuild": "$esbuild"
    },
    "sideEffects": false,
    "engines": {
        "node": ">=18.0.0"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
