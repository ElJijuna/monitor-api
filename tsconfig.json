{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2020", "ESNext.Disposable", "DOM", "DOM.Iterable"],
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "ignoreDeprecations": "6.0"
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
